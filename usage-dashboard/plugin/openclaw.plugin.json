{
  "id": "afp-skill-observer",
  "name": "AFP Skill Observer",
  "description": "Private, prospective named skill instruction-load metadata.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "allowlistPath",
      "eventsPath"
    ],
    "properties": {
      "allowlistPath": {
        "type": "string",
        "minLength": 2,
        "maxLength": 4096,
        "pattern": "^/"
      },
      "eventsPath": {
        "type": "string",
        "minLength": 2,
        "maxLength": 4096,
        "pattern": "^/"
      }
    }
  }
}
